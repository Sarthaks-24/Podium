# podium-server configuration.
# Copy to server/.env for local work (git-ignored), or to
# /etc/podium/server.env on the VM (root-owned, mode 600). Variables are
# listed in the order the server reads them. The server refuses to start
# and names the variable when a required one is missing or still holds a
# placeholder.
# The judge token is added here in milestone M3, when the worker API lands.

# Public URL that students open, used for sign-in redirects, cookie flags
# and the cross-site request check.
# Required. Local: http://localhost:5173 (the Vite dev server).
# VM: your HTTPS address, e.g. https://contest.example.edu
PODIUM_BASE_URL=https://change-me.example.edu

# Address the HTTP server binds. Caddy proxies to it on the VM.
# Optional. Default: 127.0.0.1:8080
PODIUM_LISTEN=127.0.0.1:8080

# SQLite database file. The directory is created if missing.
# Optional. Default: data/podium.db (VM: /var/lib/podium/db/podium.db)
PODIUM_DB_PATH=data/podium.db

# Directory holding test files, named by their SHA-256.
# Optional. Default: data/tests (VM: /var/lib/podium/tests)
PODIUM_TESTS_DIR=data/tests

# Your Google account email. It is always an owner (the recovery path if
# every other owner is removed), may sign in from any domain, and is shown
# on the sign-in page as the organiser to contact.
# Required.
PODIUM_OWNER_EMAIL=you@change-me.example.edu

# Email domains allowed to sign in, comma-separated, e.g. college.edu.
# Read only on the very first start, to seed the list; after that owners
# manage the list on the People page and this value is ignored.
# Optional. Default: none (only organisers can sign in until a domain is added).
PODIUM_ALLOWED_DOMAINS=

# Random secret that signs the short-lived sign-in state cookie.
# Required. At least 32 characters. Generate with: openssl rand -base64 48
# Changing it only interrupts sign-ins in progress; sessions stay valid.
PODIUM_SESSION_SECRET=change-me

# Client ID of the OAuth client for "Sign in with Google".
# Required. Create it in the Google Cloud console: APIs and Services,
# Credentials, Create credentials, OAuth client ID, type "Web application".
# Authorised redirect URI: <PODIUM_BASE_URL>/api/auth/google/callback
# (local: http://localhost:5173/api/auth/google/callback).
GOOGLE_CLIENT_ID=your-google-client-id

# Client secret of the same OAuth client, shown next to the client ID in
# the Google Cloud console.
# Required. Secret: never commit it or paste it into chat.
GOOGLE_CLIENT_SECRET=change-me

# Minimum log level: debug, info, warn or error.
# Optional. Default: info
PODIUM_LOG_LEVEL=info
