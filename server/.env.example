# podium-server configuration.
# Copy to server/.env for local work (git-ignored), or to
# /etc/podium/server.env on the VM (root-owned, mode 600). Variables are
# listed in the order the server reads them. The server refuses to start
# and names the variable when a required one is missing.
# Further variables (Google sign-in, session secret, judge token) are added
# here in the milestone whose code reads them.

# Public URL that students open, used for sign-in redirects and links.
# Required. Local: http://localhost:5173 (the Vite dev server).
# VM: your HTTPS address, e.g. https://contest.example.edu
PODIUM_BASE_URL=https://change-me.example.edu

# Address the HTTP server binds. Caddy proxies to it on the VM.
# Optional. Default: 127.0.0.1:8080
PODIUM_LISTEN=127.0.0.1:8080

# SQLite database file. The directory is created if missing.
# Optional. Default: data/podium.db (VM: /var/lib/podium/db/podium.db)
PODIUM_DB_PATH=data/podium.db

# Directory holding test files, named by their SHA-256.
# Optional. Default: data/tests (VM: /var/lib/podium/tests)
PODIUM_TESTS_DIR=data/tests

# Minimum log level: debug, info, warn or error.
# Optional. Default: info
PODIUM_LOG_LEVEL=info
