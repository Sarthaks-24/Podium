# podium-server configuration.
# Copy to server/.env for local work (git-ignored), or to
# /etc/podium/server.env on the VM (root-owned, mode 600). Variables are
# listed in the order the server reads them. The server refuses to start
# and names the variable when a required one is missing or still holds a
# placeholder.
#
# What is required depends on PODIUM_MODE:
#   testing     nothing; no Google sign-in, everything on loopback
#   dev         base URL, owner, session secret, Google client
#   production  everything, an https base URL and your own judge token
# `make dev-test` runs testing mode without this file at all.

# Run mode: testing, dev or production. testing turns Google sign-in off
# and lets anyone at this machine sign in as anyone from a form, so it
# only runs on loopback. dev is local work with real Google sign-in over
# http. production is strict.
# Optional. Default: production
PODIUM_MODE=production

# Public URL that students open, used for sign-in redirects, cookie flags
# and the cross-site request check. Scheme and host only, no path.
# testing: optional, default http://localhost:5173, must be a localhost address.
# dev: required, http is fine (local: http://localhost:5173, the Vite dev server).
# production: required, must be https, e.g. https://contest.example.edu
PODIUM_BASE_URL=https://change-me.example.edu

# Address the web and API server binds. Caddy proxies to it on the VM.
# Optional. Default: 127.0.0.1:8080 (testing and production: must be a
# loopback address; in production Caddy is the public listener)
PODIUM_LISTEN=127.0.0.1:8080

# Address of the judge worker API, a separate listener that never sits
# behind Caddy. Must be a loopback address in every mode and differ from
# PODIUM_LISTEN. Reach a judge on another machine through an SSH or
# WireGuard tunnel (docs/OPERATIONS.md).
# Optional. Default: 127.0.0.1:8081
PODIUM_JUDGE_LISTEN=127.0.0.1:8081

# SQLite database file. The directory is created if missing.
# Optional. Default: data/podium.db (VM: /var/lib/podium/db/podium.db)
PODIUM_DB_PATH=data/podium.db

# Directory holding test files and program sources, named by their SHA-256.
# Optional. Default: data/tests (VM: /var/lib/podium/tests)
PODIUM_TESTS_DIR=data/tests

# Folder of the nightly backups (podium-backup writes it, the server only reads
# the time of the newest for the Dashboard's Live tab). Use the same value as
# PODIUM_BACKUP_DIR in backup.env.
# Optional. Default: /var/backups/podium
PODIUM_BACKUP_DIR=/var/backups/podium

# Your Google account email. It is always an owner (the recovery path if
# every other owner is removed), may sign in from any domain, and is shown
# on the sign-in page as the organiser to contact.
# testing: optional, default owner@podium.test.
# dev and production: required.
PODIUM_OWNER_EMAIL=you@change-me.example.edu

# Random secret that signs the short-lived sign-in state cookie.
# At least 32 characters. Generate with: openssl rand -base64 48
# Changing it only interrupts sign-ins in progress; sessions stay valid.
# testing: optional, a random secret is made for each run.
# dev and production: required.
PODIUM_SESSION_SECRET=change-me

# Client ID of the OAuth client for "Sign in with Google".
# Create it in the Google Cloud console: APIs and Services, Credentials,
# Create credentials, OAuth client ID, type "Web application".
# Authorised redirect URI: <PODIUM_BASE_URL>/api/auth/google/callback
# (local: http://localhost:5173/api/auth/google/callback).
# testing: not read. dev and production: required.
GOOGLE_CLIENT_ID=your-google-client-id

# Client secret of the same OAuth client, shown next to the client ID in
# the Google Cloud console. Secret: never commit it or paste it into chat.
# testing: not read. dev and production: required.
GOOGLE_CLIENT_SECRET=change-me

# Shared token the judge worker sends to the judge API. At least 32
# characters. Generate with: openssl rand -hex 32
# Put the same value in judge.env (judge/.env locally).
# testing and dev: optional; leave it empty to use the built-in public
# testing token, which pairs a local judge with no setup.
# production: required, and the public testing token is refused.
PODIUM_JUDGE_TOKEN=change-me

# Minimum log level: debug, info, warn or error.
# Optional. Default: info
PODIUM_LOG_LEVEL=info
