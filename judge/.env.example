# podium-judge configuration.
# Copy to judge/.env for local work in WSL2 (git-ignored), or to
# /etc/podium/judge.env on the VM (root-owned, mode 600). Variables are
# listed in the order the judge reads them. "podium-judge work" reads all
# of them; "podium-judge calibrate" needs only the sandbox settings
# (PODIUM_ISOLATE_PATH onwards).
# `make dev-test` runs the judge in testing mode without this file at all.

# Run mode: testing, dev or production, as on the server. Outside
# production the token may be left empty and the public testing token is
# used.
# Optional. Default: production
PODIUM_MODE=production

# The server's judge API address: its PODIUM_JUDGE_LISTEN, as a URL with
# no path. For a judge on another machine, point it at the local end of
# the SSH or WireGuard tunnel (docs/OPERATIONS.md).
# Optional. Default: http://127.0.0.1:8081
PODIUM_SERVER_URL=http://127.0.0.1:8081

# Shared token for the judge API: the same value as PODIUM_JUDGE_TOKEN in
# server.env (server/.env locally). At least 32 characters. Generate it
# once with: openssl rand -hex 32
# testing and dev: optional; leave it empty to use the built-in public
# testing token.
# production: required, and the public testing token is refused.
PODIUM_JUDGE_TOKEN=change-me

# Path of the setuid isolate binary installed by deploy/install.sh.
# Optional. Default: /usr/bin/isolate
PODIUM_ISOLATE_PATH=/usr/bin/isolate

# Number of sandboxes judged in parallel; each uses one isolate box id.
# Optional. Default: 2 (the 2 GB VM budget, see docs/ARCHITECTURE.md). Range 1 to 16.
PODIUM_JUDGE_LANES=2

# Directory for cached test files, sources and compiled programs.
# Optional. Default: /var/cache/podium-judge
PODIUM_JUDGE_CACHE_DIR=/var/cache/podium-judge

# Minimum log level: debug, info, warn or error.
# Optional. Default: info
PODIUM_LOG_LEVEL=info
