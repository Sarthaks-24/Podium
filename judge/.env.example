# podium-judge configuration.
# Copy to judge/.env for local work in WSL2 (git-ignored), or to
# /etc/podium/judge.env on the VM (root-owned, mode 600). Variables are
# listed in the order the judge reads them. "podium-judge work" reads all
# of them; "podium-judge calibrate" needs only the sandbox settings
# (PODIUM_ISOLATE_PATH, PODIUM_JUDGE_LANES, PODIUM_JUDGE_CACHE_DIR and
# PODIUM_LOG_LEVEL).
# `make dev-test` runs the judge in testing mode without this file at all.

# Run mode: testing, dev or production, as on the server. Outside
# production the token may be left empty and the public testing token is
# used.
# Optional. Default: production
PODIUM_MODE=production

# The server's judge API address: its PODIUM_JUDGE_LISTEN, as a URL with
# no path. For a judge on another machine, point it at the local end of
# the SSH or WireGuard tunnel (docs/OPERATIONS.md). In production a plain
# http address must be loopback, so the token never crosses the network in
# clear; https may point anywhere.
# Optional. Default: http://127.0.0.1:8081
PODIUM_SERVER_URL=http://127.0.0.1:8081

# Shared token for the judge API: the same value as PODIUM_JUDGE_TOKEN in
# server.env (server/.env locally). At least 32 characters. Generate it
# once with: openssl rand -hex 32
# testing and dev: optional; leave it empty to use the built-in public
# testing token.
# production: required, and the public testing token is refused.
PODIUM_JUDGE_TOKEN=change-me

# Path of the setuid isolate binary installed by deploy/install.sh.
# Optional. Default: /usr/bin/isolate
PODIUM_ISOLATE_PATH=/usr/bin/isolate

# Number of sandboxes judged in parallel; each uses one isolate box id.
# Optional. Default: empty, which means one lane per vCPU (the judge sizes
# itself to the machine, see docs/OPERATIONS.md). Range 1 to 16. A value
# above the machine's vCPUs is refused at start. Leave it empty unless you
# need fewer lanes.
PODIUM_JUDGE_LANES=

# Memory in MB the sandboxes may hold at once. The root pre-start step sets
# the sandbox slice's cap to this plus 76 MB for this boot.
# Optional. Default: empty, which means the judge chooses from the machine's
# memory (1,024 MB on 2 GB, about 3,900 MB on 8 GB, at most 4,096 MB).
# Range 1024 to 1048576. A value below 1024 (the smallest the judge ever
# chooses) or above what the machine can hold (half its memory less 196 MB)
# is refused at start. Leave it empty unless you know better.
PODIUM_JUDGE_MEMORY_BUDGET_MB=

# First isolate box id; lane n uses box PODIUM_JUDGE_BOX_BASE + n. Set it
# only when a second judge or the sandbox tests share this host, so each
# uses other boxes. The boxes must keep clear of box 80 (selftest).
# Optional. Default: 0. Range 0 to 984.
PODIUM_JUDGE_BOX_BASE=0

# Directory for cached test files, sources and compiled programs.
# Optional. Default: /var/cache/podium-judge
PODIUM_JUDGE_CACHE_DIR=/var/cache/podium-judge

# Cap on the downloaded tests and sources in the cache directory's blobs/
# folder, in MB. Above it the least recently used files that no running
# job needs are removed after each job (they download again on demand).
# Compiled programs have their own fixed 500 MB cap.
# Optional. Default: 2048. Range 64 to 1048576.
PODIUM_JUDGE_BLOB_CACHE_MB=2048

# Batched reports (v2.1.0, J6). on: the judge sends a job's test results
# in the background, in batches, while the next test runs, instead of
# waiting for the server's answer after every test. The protocol and the
# server are unchanged. It exists to be measured on a test machine; leave it
# off unless the v2.1.0 test session showed it helps (docs/OPERATIONS.md).
# Optional. Default: off. Values: on or off.
PODIUM_JUDGE_ASYNC_REPORTS=off

# Precompiled header (v2.1.0, J5). on: student C++ is compiled with a
# precompiled <bits/stdc++.h> from /usr/local/lib/podium-pch, built by
# install.sh and upgrade (or by hand: sudo podium-judge pch build). The judge
# uses it only if the files are root-owned and a probe compile loads them;
# otherwise it logs one line and compiles normally. It exists to be measured
# on a test machine; leave it off unless the v2.1.0 test session showed it
# helps (docs/OPERATIONS.md).
# Optional. Default: off. Values: on or off.
PODIUM_JUDGE_PCH=off

# Minimum log level: debug, info, warn or error.
# Optional. Default: info
PODIUM_LOG_LEVEL=info
