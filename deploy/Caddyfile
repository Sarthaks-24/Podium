# Installed by deploy/install.sh, which replaces PODIUM_HOST with the host of
# PODIUM_BASE_URL and appends a www redirect when www.<host> resolves.
# Caddy obtains and renews the TLS certificate itself and redirects http to
# https.

{
	# No admin API: nothing on the VM can reconfigure Caddy through
	# localhost:2019. A configuration change needs a restart
	# (install.sh caddy does it), not a reload.
	admin off
}

PODIUM_HOST {
	# Refuse bodies larger than the server would read anyway: the largest
	# is a 32 MB problem pack. Caddy stops them at the edge instead of
	# streaming them to the server.
	request_body {
		max_size 33MB
	}

	# Browsers go straight to https after the first visit, so a rogue
	# campus access point cannot answer the plain http request.
	header Strict-Transport-Security "max-age=31536000"

	# Server-sent events must not be buffered by compression.
	@compressible not path /api/events*
	encode @compressible zstd gzip

	reverse_proxy 127.0.0.1:8080 {
		flush_interval -1
	}
}
