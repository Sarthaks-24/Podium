#!/usr/bin/env bash
# Remove only the isolate boxes assigned to this judge before it starts.
set -euo pipefail

box_root=/var/lib/isolate
box_base=${PODIUM_JUDGE_BOX_BASE:-0}
lanes=${PODIUM_JUDGE_LANES:-2}

if [[ ! $box_base =~ ^[0-9]{1,3}$ || ! $lanes =~ ^[0-9]{1,2}$ ]]; then
  echo "invalid judge box range" >&2
  exit 1
fi
box_base=$((10#$box_base))
lanes=$((10#$lanes))
if (( box_base > 984 || lanes < 1 || lanes > 16 || box_base + lanes - 1 > 999 )); then
  echo "invalid judge box range" >&2
  exit 1
fi
if (( box_base <= 80 && box_base + lanes > 80 )); then
  echo "judge box range includes isolate selftest box 80" >&2
  exit 1
fi

for ((lane = 0; lane < lanes; lane++)); do
  box=$((box_base + lane))
  rm -rf --one-file-system -- "$box_root/$box"
done
