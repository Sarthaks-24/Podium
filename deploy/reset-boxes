#!/usr/bin/env bash
# Root pre-start step of podium-judge.service. It asks "podium-judge size"
# how big this judge is (the one place that decides: lanes, the sandbox cap,
# the judge unit's cap), removes only the isolate boxes assigned to this
# judge, and sets the caps of isolate.slice and of the judge unit for this
# boot with systemctl set-property --runtime. Runtime properties are gone at
# the next reboot, and this step sets them again at every start. The
# drop-in and unit file keep the 2 GB values as the base.
set -euo pipefail

box_root=/var/lib/isolate
judge_bin=${PODIUM_JUDGE_BIN:-/usr/local/bin/podium-judge}
box_base=${PODIUM_JUDGE_BOX_BASE:-0}

# A refusal (a hand-set value the machine cannot hold) is already written to
# stderr by the judge, so the journal names the variable.
size=$("$judge_bin" size)
lanes='' sandbox_cap='' unit_cap=''
while IFS== read -r key value; do
  if [[ ! $value =~ ^[0-9]{1,7}$ ]]; then
    echo "podium-judge size gave an unreadable line: $key" >&2
    exit 1
  fi
  case $key in
    lanes) lanes=$((10#$value)) ;;
    sandbox_cap_mb) sandbox_cap=$((10#$value)) ;;
    unit_cap_mb) unit_cap=$((10#$value)) ;;
    *) echo "podium-judge size gave an unknown line: $key" >&2; exit 1 ;;
  esac
done <<< "$size"
if [[ -z $lanes || -z $sandbox_cap || -z $unit_cap ]]; then
  echo "podium-judge size did not give lanes and both caps" >&2
  exit 1
fi
# Root does not trust the shape alone. The bounds are Size's own: 1 to 16
# lanes; a sandbox cap of at least 1,100 MB (the 2 GB machine) and at most
# the largest hand-set budget, 1,048,576 MB, plus 76; a unit cap of 128 MB
# per lane, so 128 to 2,048.
if (( lanes < 1 || lanes > 16 || sandbox_cap < 1100 || sandbox_cap > 1048652 || unit_cap < 128 || unit_cap > 2048 )); then
  echo "podium-judge size gave numbers outside what it can give: lanes=$lanes sandbox_cap_mb=$sandbox_cap unit_cap_mb=$unit_cap" >&2
  exit 1
fi

if [[ ! $box_base =~ ^[0-9]{1,3}$ ]]; then
  echo "invalid judge box range" >&2
  exit 1
fi
box_base=$((10#$box_base))
if (( box_base > 984 || lanes < 1 || lanes > 16 || box_base + lanes - 1 > 999 )); then
  echo "invalid judge box range" >&2
  exit 1
fi
if (( box_base <= 80 && box_base + lanes > 80 )); then
  echo "judge box range includes isolate selftest box 80" >&2
  exit 1
fi

for ((lane = 0; lane < lanes; lane++)); do
  box=$((box_base + lane))
  rm -rf --one-file-system -- "$box_root/$box"
done

systemctl set-property --runtime isolate.slice "MemoryMax=${sandbox_cap}M"
systemctl set-property --runtime podium-judge.service "MemoryMax=${unit_cap}M"
