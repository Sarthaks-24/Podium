[Unit]
Description=Podium judge worker
# A failure (a crash, an OOM kill, a stop that timed out) posts an alert;
# the unit still restarts.
OnFailure=podium-alert@%n.service
After=network-online.target isolate.service podium-server.service
Wants=network-online.target
Requires=isolate.service

[Service]
User=judge
Group=judge
EnvironmentFile=/etc/podium/judge.env
ExecStart=/usr/local/bin/podium-judge work
Restart=always
RestartSec=2
# Exit 3: the server speaks another judge protocol (an upgrade put a
# different release on one side). Restarting cannot fix it, so the judge
# stays stopped with the message in its log until install.sh starts it.
# Exit 4: the server kept refusing the judge token (401); fix
# PODIUM_JUDGE_TOKEN so both env files match, then start the judge. Either
# exit leaves the unit failed, so OnFailure alerts.
RestartPreventExitStatus=3 4
# SIGTERM stops claiming; each lane finishes and reports the job it holds,
# then the worker exits (graceful stop, used by install.sh upgrade). Real
# jobs take seconds; 20 minutes covers a long validation. A job still
# running then is killed and requeued by the server once its 60 s lease
# runs out. A second SIGTERM abandons the jobs at once.
TimeoutStopSec=20min
# Send that SIGTERM to the worker only. The default (control-group) would
# also signal the isolate processes the worker started, killing the very
# runs the stop is meant to let finish. Whatever is left at the timeout
# gets SIGKILL.
KillMode=mixed
# Covers the worker process only. Sandboxes run in isolate.slice, which has
# its own cap (isolate.slice.d/podium.conf). Inputs and programs the worker
# copies into the tmpfs box root are charged here until the box is
# destroyed, hence the headroom above the Go heap limit.
MemoryMax=256M
Environment=GOMEMLIMIT=96MiB
# isolate is setuid root, so NoNewPrivileges and ProtectSystem stay off.
# The judge never touches the database: hide it entirely.
InaccessiblePaths=/var/lib/podium
ProtectHome=yes

[Install]
WantedBy=multi-user.target
