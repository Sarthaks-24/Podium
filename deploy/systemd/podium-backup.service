# Installed by deploy/install.sh. Started by podium-backup.timer every
# night; also safe to start by hand: sudo systemctl start podium-backup
[Unit]
Description=Podium nightly backup (database and test files)
After=podium-server.service
OnFailure=podium-alert@%n.service

[Service]
Type=oneshot
User=podium
Group=podium
# Optional settings (off-host copy, days kept); the leading "-" means the
# file may be absent.
EnvironmentFile=-/etc/podium/backup.env
# Backups hold every student's code: readable by podium only.
UMask=0077
ExecStart=/usr/local/lib/podium/podium-backup
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
# "full", not "strict": strict would mount /var/lib/podium and
# /var/backups/podium separately, and hard links (the cheap nightly copy of
# the test files) cannot cross mounts. File permissions still limit the
# podium user to its own directories.
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
