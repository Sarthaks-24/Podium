[Unit]
Description=Podium contest server
# A failure (a crash, an OOM kill, a stop that timed out) posts an alert;
# the unit still restarts.
OnFailure=podium-alert@%n.service
After=network-online.target
Wants=network-online.target

[Service]
User=podium
Group=podium
EnvironmentFile=/etc/podium/server.env
ExecStart=/usr/local/bin/podium-server
Restart=always
RestartSec=2
MemoryMax=300M
# The Go heap limit sits below MemoryMax, so under memory pressure the
# server collects garbage harder instead of being killed by the kernel.
Environment=GOMEMLIMIT=220MiB
LimitNOFILE=65536
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/podium
# The server needs no capabilities, devices, kernel knobs or other
# processes; check with `systemd-analyze security podium-server`.
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Group podium (Litestream as podium-backup) shares the database files.
UMask=0007

[Install]
WantedBy=multi-user.target
