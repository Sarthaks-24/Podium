# Litestream (database replication) configuration for podium.
# install.sh copies this to /etc/podium/litestream.env (root-owned, mode
# 600) when it does not exist; fill in the values there, never in the
# repository. The podium-litestream unit refuses to start while any value
# below is missing or still change-me. See docs/OPERATIONS.md, "Backups".

# Access key ID of a bucket-scoped application key. For Backblaze B2:
# B2 web console, Application Keys, Add a New Application Key, allow
# access to this one bucket only, Read and Write. The "keyID" goes here.
# Required.
LITESTREAM_ACCESS_KEY_ID=change-me

# That key's secret ("applicationKey" in B2, shown once when created).
# Required. Secret.
LITESTREAM_SECRET_ACCESS_KEY=change-me

# Bucket name. For B2: Buckets, Create a Bucket, private, default
# encryption on. Keep file versions at "Keep only the last version":
# Litestream manages its own history.
# Required.
PODIUM_BACKUP_BUCKET=change-me

# Folder inside the bucket for this server's database, so one bucket can
# hold several servers.
# Required. Example: podium
PODIUM_BACKUP_PATH=podium

# S3 endpoint of the bucket's region, with https://. For B2 it is shown on
# the bucket's page as "Endpoint", for example
# https://s3.us-west-004.backblazeb2.com
# Required.
PODIUM_BACKUP_ENDPOINT=change-me

# Region of that endpoint: for B2 the part after "s3." in the endpoint,
# for example us-west-004.
# Required.
PODIUM_BACKUP_REGION=change-me
