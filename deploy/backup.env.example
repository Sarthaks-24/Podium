# Nightly backup settings for podium (podium-backup.service). Optional:
# without this file the backup stays on the VM in /var/backups/podium.
# install.sh copies it to /etc/podium/backup.env (root-owned, mode 600)
# when it does not exist. See docs/OPERATIONS.md, "Backups".

# Where to copy /var/backups/podium after each nightly run, with rsync
# over ssh, as user@host:/path. The podium user's key
# (/var/lib/podium/.ssh/id_ed25519) must be accepted there; restrict it on
# the other machine to that folder (for example rrsync). This is what
# carries the test files off the VM: Litestream only replicates the
# database.
# Optional. Default: empty (no copy off the VM). Example:
# PODIUM_BACKUP_RSYNC=podium-backup@backup.example.edu:/srv/podium
PODIUM_BACKUP_RSYNC=

# Days of nightly backups to keep, here and on the copy.
# Optional. Default: 14
PODIUM_BACKUP_KEEP_DAYS=14
