# Nightly backup settings for podium (podium-backup.service). install.sh
# copies this to /etc/podium/backup.env (root-owned, mode 600) when it does
# not exist. Every variable is optional: with the file untouched the
# backup stays on the VM in /var/backups/podium. Variables are listed in
# the order podium-backup reads them; at start it prints each one as set,
# default or missing, never a value. See docs/OPERATIONS.md, "Backups".

# The live database to copy.
# Optional. Default: /var/lib/podium/db/podium.db (as in server.env)
PODIUM_DB_PATH=

# The live test files and program sources.
# Optional. Default: /var/lib/podium/tests (as in server.env)
PODIUM_TESTS_DIR=

# Where the nightly backups go, one folder per night plus "latest".
# install.sh backup creates it (podium, mode 700).
# Optional. Default: /var/backups/podium
PODIUM_BACKUP_DIR=

# Days of nightly backups to keep, here, in the B2 folder and on the rsync
# copy.
# Optional. Default: 14
PODIUM_BACKUP_KEEP_DAYS=14

# The server binary whose "check" verifies each backup before it counts.
# Optional. Default: /usr/local/bin/podium-server
PODIUM_SERVER_BIN=

# Where to copy /var/backups/podium after each nightly run, with rsync
# over ssh, as user@host:/path, with root's key
# /etc/podium/backup-ssh/id_ed25519 (the folder root's, mode 700; the
# server's user cannot read it). The key must be accepted there; restrict
# it on the other machine to that folder (for example rrsync). An
# alternative or an addition to the encrypted B2 copy below.
# Optional. Default: empty (no rsync copy). Example:
# PODIUM_BACKUP_RSYNC=podium-backup@backup.example.edu:/srv/podium
PODIUM_BACKUP_RSYNC=

# The encrypted copy off the VM: each night's backup (database copy, test
# files, check report) is packed, encrypted to this age public key, and
# uploaded to B2. The next five variables go together: set all or none.
#
# The age public key, one line starting with age1. Make the key pair on
# your own machine with: age-keygen -o podium-backup.key
# (it prints "Public key: age1..."). Keep podium-backup.key off the VM, in
# your password manager and one offline place: without it the copies
# cannot be decrypted, and with it anyone can read them.
# Optional, required for the encrypted copy. Default: empty (no copy).
PODIUM_BACKUP_AGE_RECIPIENT=

# Bucket and folder for the encrypted copies, as bucket/folder, without
# "b2:". Use its own private bucket, not Litestream's. Backblaze B2 web
# console: Buckets, Create a Bucket, private, Object Lock on with a default
# retention of 13 days, so a copy cannot be deleted from the VM before the
# 14-day prune (docs/OPERATIONS.md, "Encrypted copy off the VM").
# Optional, required for the encrypted copy. Example: podium-tests/nightly
PODIUM_BACKUP_B2_PATH=

# rclone's backend type for the remote named b2. Always b2.
# Optional, required for the encrypted copy. Value: b2
RCLONE_CONFIG_B2_TYPE=

# keyID of a B2 application key limited to that one bucket, with read and
# write access (B2 web console: Application Keys, Add a New Application
# Key, "Allow access to Bucket(s)": that bucket).
# Optional, required for the encrypted copy.
RCLONE_CONFIG_B2_ACCOUNT=

# applicationKey of the same key, shown once when it is created. Secret.
# Optional, required for the encrypted copy.
RCLONE_CONFIG_B2_KEY=

# Dead-man heartbeat: pinged with a GET after every fully successful
# backup, so the heartbeat service alerts when a night is missed. Secret
# (anyone with it can fake a backup). From your heartbeat service, for
# example healthchecks.io: Add Check, period 1 day, grace 6 hours, then
# copy its ping URL. Must start with https://.
# Optional. Default: empty (no ping).
PODIUM_HEARTBEAT_URL=
