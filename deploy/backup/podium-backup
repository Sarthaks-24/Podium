#!/usr/bin/env bash
# Nightly backup of podium (podium-backup.timer runs it as root, and it
# does its work as two users, below):
#
#   /var/backups/podium/<UTC date and time>/podium.db   consistent copy
#   /var/backups/podium/<UTC date and time>/tests/      test files, sources
#
# The database is copied with SQLite's online backup, which is safe while
# the server writes. Test files are named by their SHA-256 and never change
# once written, so each night's tests/ is a tree of hard links into
# /var/lib/podium/tests: a new night costs only the files added since. A
# file the server later removes stays in the backups that link to it.
# Each backup is checked with "podium-server check" before it counts, and
# backups older than PODIUM_BACKUP_KEEP_DAYS are deleted.
#
# Everything is created readable by the podium user only (umask 077): the
# backup holds every student's code and the session table.
#
# Two users (D116). The copy, the check, the pruning, tar and age run as
# podium with an empty environment, so no process of user podium (the
# server's) ever holds the B2 key or the heartbeat URL. Only rclone and
# the heartbeat ping run as podium-backup with those variables, and
# rclone reads the encrypted stream on stdin, never the backup folder.
# Run as any other user (by hand, or the tests) it does everything as
# that user.
#
# Off the VM, two optional copies (settings in /etc/podium/backup.env,
# template deploy/backup.env.example):
#   - the encrypted copy: the new backup packed with tar, encrypted with
#     age to PODIUM_BACKUP_AGE_RECIPIENT (a public key; the private key
#     never comes near the VM) and streamed to Backblaze B2 with rclone.
#     This is what carries the test files off the VM: Litestream only
#     replicates the database.
#   - PODIUM_BACKUP_RSYNC: the whole backup folder copied with rsync over
#     ssh to a machine you run.
# After everything succeeded it pings PODIUM_HEARTBEAT_URL, so a dead-man
# service notices a night without a backup.
#
# Run by hand: sudo systemctl start podium-backup
set -euo pipefail
umask 077

env_file=/etc/podium/backup.env
die() { printf 'podium-backup: %s\n' "$*" >&2; exit 1; }

if (( EUID == 0 )); then
  id podium >/dev/null 2>&1 || die "user podium missing; run: sudo ./install.sh users"
  id podium-backup >/dev/null 2>&1 || die "user podium-backup missing; run: sudo ./install.sh users"
  # as_podium: the local work, with an environment that holds nothing
  # secret. as_offsite: rclone and the heartbeat, with the variables.
  # env -i runs first, as root: the environment is empty before the uid
  # changes, so no podium process ever holds the key, even for an exec.
  as_podium() { env -i PATH="$PATH" HOME=/var/lib/podium LC_ALL=C.UTF-8 setpriv --reuid=podium --regid=podium --init-groups -- "$@"; }
  as_offsite() { setpriv --reuid=podium-backup --regid=podium-backup --init-groups -- "$@"; }
else
  as_podium() { "$@"; }
  as_offsite() { "$@"; }
fi

# Start-up check: each variable in the order read, as set, default or
# missing. Never a value: the B2 key and the heartbeat URL are secrets.
report() { # NAME DEFAULT_TEXT
  local v=${!1:-}
  if [[ -n $v && $v != change-me ]]; then echo "podium-backup: $1 set"
  elif [[ -n $2 ]]; then echo "podium-backup: $1 default"
  else echo "podium-backup: $1 missing"
  fi
}
value() { local v=${!1:-}; [[ $v == change-me ]] && v=; printf '%s' "$v"; }

for v in PODIUM_DB_PATH PODIUM_TESTS_DIR PODIUM_BACKUP_DIR PODIUM_BACKUP_KEEP_DAYS PODIUM_SERVER_BIN; do report "$v" yes; done
for v in PODIUM_BACKUP_RSYNC PODIUM_BACKUP_AGE_RECIPIENT PODIUM_BACKUP_B2_PATH \
         RCLONE_CONFIG_B2_TYPE RCLONE_CONFIG_B2_ACCOUNT RCLONE_CONFIG_B2_KEY PODIUM_HEARTBEAT_URL; do report "$v" ""; done

db=$(value PODIUM_DB_PATH); db=${db:-/var/lib/podium/db/podium.db}
tests=$(value PODIUM_TESTS_DIR); tests=${tests:-/var/lib/podium/tests}
dest=$(value PODIUM_BACKUP_DIR); dest=${dest:-/var/backups/podium}
keep=$(value PODIUM_BACKUP_KEEP_DAYS); keep=${keep:-14}
server=$(value PODIUM_SERVER_BIN); server=${server:-/usr/local/bin/podium-server}
remote=$(value PODIUM_BACKUP_RSYNC)
recipient=$(value PODIUM_BACKUP_AGE_RECIPIENT)
b2path=$(value PODIUM_BACKUP_B2_PATH)
heartbeat=$(value PODIUM_HEARTBEAT_URL)

[[ -f $db ]] || die "no database at $db (PODIUM_DB_PATH in $env_file)"
[[ -d $dest ]] || die "$dest does not exist; run: sudo ./install.sh backup"
command -v sqlite3 >/dev/null || die "sqlite3 is not installed; run: sudo ./install.sh packages"
[[ $keep =~ ^[0-9]+$ && $keep -ge 1 ]] || die "PODIUM_BACKUP_KEEP_DAYS must be a whole number of days, 1 or more (in $env_file)"
if [[ -n $remote ]]; then
  [[ $remote == *:* && $remote != -* ]] || die "PODIUM_BACKUP_RSYNC must look like user@host:/path (in $env_file)"
  command -v rsync >/dev/null || die "rsync is not installed; run: sudo ./install.sh packages"
fi

# The encrypted copy needs all five of its variables, or none.
offsite=()
for v in PODIUM_BACKUP_AGE_RECIPIENT PODIUM_BACKUP_B2_PATH RCLONE_CONFIG_B2_TYPE RCLONE_CONFIG_B2_ACCOUNT RCLONE_CONFIG_B2_KEY; do
  [[ -n $(value "$v") ]] || offsite+=("$v")
done
encrypt=no
if (( ${#offsite[@]} == 0 )); then
  encrypt=yes
  [[ $recipient == age1* ]] || die "PODIUM_BACKUP_AGE_RECIPIENT must be an age public key starting with age1 (in $env_file)"
  [[ $(value RCLONE_CONFIG_B2_TYPE) == b2 ]] || die "RCLONE_CONFIG_B2_TYPE must be b2 (in $env_file)"
  [[ $b2path != /* && $b2path != *:* ]] \
    || die "PODIUM_BACKUP_B2_PATH must be bucket/folder, without b2: or a leading / (in $env_file)"
  command -v age >/dev/null || die "age is not installed; run: sudo ./install.sh backup"
  command -v rclone >/dev/null || die "rclone is not installed; run: sudo ./install.sh backup"
elif (( ${#offsite[@]} < 5 )); then
  die "the encrypted off-VM copy is half configured: set ${offsite[*]} in $env_file (docs/OPERATIONS.md, \"Encrypted copy off the VM\")"
else
  echo "podium-backup: warning: no encrypted copy off the VM; test files are lost with the VM's disk until PODIUM_BACKUP_AGE_RECIPIENT and the B2 settings are set in $env_file"
fi
if [[ -n $heartbeat && ( $heartbeat != https://* || $heartbeat == *[[:space:]]* || $heartbeat == *'"'* || $heartbeat == *'\'* ) ]]; then
  die "PODIUM_HEARTBEAT_URL must start with https:// and hold no spaces or quotes (in $env_file)"
fi

stamp=$(date -u +%Y-%m-%dT%H%MZ)
final=$dest/$stamp
work=$dest/.partial-$stamp
as_podium rm -rf "$work"
trap 'as_podium rm -rf "$work"' EXIT
as_podium mkdir -m 700 "$work"

start=$(date +%s)
# .backup holds a read transaction and copies page by page; the server keeps
# writing meanwhile (WAL). The copy is a single file with no -wal.
as_podium sqlite3 "$db" ".timeout 10000" ".backup '$work/podium.db'"

if [[ -d $tests ]]; then
  # Hard links when the backup is on the same filesystem; a real copy if not.
  as_podium cp -al "$tests" "$work/tests" 2>/dev/null || { as_podium rm -rf "$work/tests"; as_podium cp -a "$tests" "$work/tests"; }
else
  as_podium mkdir "$work/tests"
fi

if [[ -x $server ]]; then
  as_podium sh -c '"$1" check -db "$2/podium.db" -tests "$2/tests" > "$2/check.txt" 2>&1' check "$server" "$work" \
    || { as_podium cat "$work/check.txt" >&2; die "the new backup failed its check; kept nothing"; }
else
  [[ $(as_podium sqlite3 "$work/podium.db" "PRAGMA integrity_check") == ok ]] || die "integrity_check failed on the copy"
  as_podium sh -c 'echo "integrity_check: ok ($1 not found, so test files were not checked)" > "$2/check.txt"' note "$server" "$work"
fi

as_podium mv "$work" "$final"
trap - EXIT
as_podium ln -sfn "$stamp" "$dest/latest"

# Keep PODIUM_BACKUP_KEEP_DAYS days. Names sort by date; never touch the
# newest, whatever the clock says.
cutoff=$(date -u -d "-$keep days" +%Y-%m-%dT%H%MZ)
for d in "$dest"/20*; do
  if [[ -d $d && $(basename "$d") < $cutoff && $d != "$final" ]]; then
    as_podium rm -rf "$d"
  fi
done

size=$(as_podium du -sh "$final/podium.db" | cut -f1)
files=$(as_podium find "$final/tests" -type f | wc -l)
count=$(as_podium find "$dest" -maxdepth 1 -name '20*' -type d | wc -l)
echo "podium-backup: $final done in $(( $(date +%s) - start )) s: database $size, $files test files, $count backups kept"

if [[ $encrypt == yes ]]; then
  # One object per night: podium-<stamp>.tar.age, the database copy, the
  # test files and the check report. tar | age | rclone streams it, so
  # nothing unencrypted is written twice. Small chunks and one transfer
  # keep rclone's memory near 16 MB on the 2 GB VM. --config "" keeps
  # rclone off any config file: the remote "b2" is the RCLONE_CONFIG_B2_*
  # variables.
  object="b2:$b2path/podium-$stamp.tar.age"
  rc=(as_offsite rclone --config "" --transfers 1 --b2-chunk-size 16M --retries 3 --low-level-retries 5)
  if ! as_podium tar -C "$final" -cf - podium.db tests check.txt | as_podium age -r "$recipient" | "${rc[@]}" rcat "$object"; then
    # A failed pipe may still have stored a truncated object: remove it,
    # so the bucket never holds a copy that looks whole and is not.
    "${rc[@]}" deletefile --b2-hard-delete "$object" 2>/dev/null || true
    die "the local backup is done, but the encrypted copy to B2 failed (rclone above; check the B2 key and PODIUM_BACKUP_B2_PATH)"
  fi
  # The bucket keeps the same days as the VM. Hard delete: B2 would
  # otherwise only hide the files and keep billing for them.
  "${rc[@]}" delete --b2-hard-delete --min-age "${keep}d" --include 'podium-*.tar.age' "b2:$b2path" \
    || die "the encrypted copy is uploaded, but deleting copies older than $keep days failed"
  echo "podium-backup: encrypted copy uploaded as podium-$stamp.tar.age"
fi

if [[ -n $remote ]]; then
  # -H keeps the hard links between nights, so the remote copy is as small
  # as the local one; --delete mirrors the pruning. BatchMode makes a
  # missing or unaccepted key fail at once instead of asking.
  as_podium rsync -aH --delete -e "ssh -o BatchMode=yes" -- "$dest/" "$remote/" \
    || die "the local backup is done, but copying it to $remote failed"
  echo "podium-backup: copied to $remote"
fi

if [[ -n $heartbeat ]]; then
  # Silence at the heartbeat service is the alert, so a failed ping only
  # warns here.
  # On stdin, not as an argument: the process list is visible to every
  # user, and the URL alone is enough to fake a backup.
  if printf 'url = "%s"\n' "$heartbeat" | as_offsite curl -fsS -m 15 --retry 3 -o /dev/null -K - 2>/dev/null; then
    echo "podium-backup: heartbeat sent"
  else
    echo "podium-backup: warning: the heartbeat ping failed; the heartbeat service will report a missed backup" >&2
  fi
fi
